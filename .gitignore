.venv/
__pycache__/
*.pyc

# Price cache is derived, not source.
data/prices_cache.json

# Portfolios are personal data and never belong in the repo. One directory per
# owner under portfolios/, holding the JSON, its history, broker exports and any
# screenshots they were transcribed from.
portfolios/

# The same files if they are left at the default location instead.
data/portfolio.json
data/*.json
data/*-history.csv
data/broker_export.csv
data/screenshots/

# Histories generated by running against the shipped example.
examples/*-history.csv

# IDE
.idea/
